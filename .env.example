# FILE: .env.example
# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Supabase project settings -> Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses Row Level Security. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the scheduled job that flips overdue tasks to "delayed" (used from Stage 2).
CRON_SECRET=
